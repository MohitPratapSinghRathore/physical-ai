             assets relative to registers, which bounds the direction of error in the SIPP
             balance-sheet figures used here.}
}

@article{AlbaceteFessler2010,
  author  = {Albacete, Nicolas and Fessler, Pirmin},
  title   = {Stress Testing Austrian Households},
  journal = {Financial Stability Report},
  publisher = {Oesterreichische Nationalbank},
  volume  = {19},
  pages   = {72-91},
  year    = {2010},
  url     = {https://ideas.repec.org/a/onb/oenbfs/y2010i19b2.html},
  note    = {Origin of the "financial margin" construction: income minus debt service minus
             basic consumption, stressed household by household against interest rate,
             unemployment, asset price and exchange rate shocks. The runway measures in
             src/stress/sipp\_engine.py are deliberately a bounded version of this, because
             this repository has no measured US consumption floor and will not invent one.}
}

