@article{MerikullRoom2020,
  author  = {Meri{\"k}{\"u}ll, Jaanika and R{\~o}{\~o}m, Tairi},
  title   = {Stress Tests of the Household Sector Using Microdata from Survey and
             Administrative Sources},
  journal = {International Journal of Central Banking},
  volume  = {16},
  number  = {2},
  year    = {2020},
  month   = mar,
  url     = {https://www.ijcb.org/journal/v16n2/stress-tests-household-sector-using-microdata-survey-and-administrative-sources},
  note    = {Microsimulation-based household stress test on the Estonian HFCS, survey data
             matched to administrative registers. The closest methodological precedent for
             src/stress/: household-by-household shock, not group-share attribution. Also
             the source of the warning that survey data understate liabilities and overstate
             assets relative to registers, which bounds the direction of error in the SIPP
             balance-sheet figures used here.}
}

@article{AlbaceteFessler2010,
  author  = {Albacete, Nicolas and Fessler, Pirmin},
  title   = {Stress Testing Austrian Households},
  journal = {Financial Stability Report},
  publisher = {Oesterreichische Nationalbank},
  number  = {19},
  pages   = {72--91},
  year    = {2010},
  url     = {https://ideas.repec.org/a/onb/oenbfs/y2010i19b2.html},
  note    = {Origin of the "financial margin" construction: income minus debt service minus
             basic consumption, stressed household by household against interest rate,
             unemployment, asset price and exchange rate shocks. The runway measures in
             src/stress/sipp_engine.py are deliberately a bounded version of this, because
             this repository has no measured US consumption floor and will not invent one.}
}

