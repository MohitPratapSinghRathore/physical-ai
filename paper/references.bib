@article{CohenKillenLau2026,
  author    = {Cohen, Greg and Killen, Cooper and Lau, Simon},
  title     = {Tail Risk for Banks Posed by Investments in Generative Artificial
               Intelligence},
  journal   = {Chicago Fed Insights},
  publisher = {Federal Reserve Bank of Chicago},
  year      = {2026},
  month     = feb,
  url       = {https://www.chicagofed.org/publications/chicago-fed-insights/2026/ai-tail-risk-for-banks},
  note      = {Verified figures: average bank outstanding to AI-adjacent industries about
               0.8 percent of bank total assets; large-bank C and I commitments to
               AI-adjacent industries from about 9 percent of total commitments (about
               250 billion USD) in 2015 to 13 percent (about 450 billion USD) in late 2025;
               software industry commitments 150 billion USD in early 2022 to 191 billion
               USD in late 2025; energy and semiconductor commitments combined about 275
               billion USD; C and I OUTSTANDING exposure to AI-adjacent industries averages
               9 percent of tier 1 capital and COMMITTED exposure about 25 percent of tier 1
               capital; about 26 percent (50 billion USD) of software C and I commitments
               rated B and below, against 15 billion USD for energy and semiconductors
               combined.}
}

