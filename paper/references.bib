@techreport{BhuttaBrickerDettlingKelliherLaufer2019,
  author      = {Bhutta, Neil and Bricker, Jesse and Dettling, Lisa J. and
                 Kelliher, Jimmy and Laufer, Steven M.},
  title       = {Stress Testing Household Debt},
  institution = {Board of Governors of the Federal Reserve System},
  type        = {Finance and Economics Discussion Series},
  number      = {2019-008},
  year        = {2019},
  month       = feb,
  doi         = {10.17016/FEDS.2019.008},
  url         = {https://www.federalreserve.gov/econres/feds/stress-testing-household-debt.htm},
  note        = {County-level delinquency model driven by CCAR house-price and unemployment
