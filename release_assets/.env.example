# Copy to .env and fill in. Nothing here is secret in the usual sense: no source used by
# this package requires an API key. The two contact fields are required by the SEC and
# FDIC fair-access policies, which ask automated requests to declare a real contact.
CONTACT_NAME=Your Name
CONTACT_EMAIL=you@example.org

# Optional. FRED works without a key for the series used here; set one only if you hit a
# rate limit. Never commit a real value.
FRED_API_KEY=
