__pycache__/
*.pyc
.venv/
data/raw/
!data/raw/.gitkeep

# labour backing module: re-downloadable source caches, not committed
framework/labor_backing/_z1_cache.zip
framework/labor_backing/_dfa_cache.zip

# NCUA bulk call report archive, re-downloadable from ncua.gov
framework/institutions/*.zip

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.pdf
paper/main.fls
paper/main.fdb_latexmk

# companion papers: sources are tracked, build artifacts and deliverables are not
papers/*/*.aux
papers/*/*.bbl
papers/*/*.blg
papers/*/*.log
papers/*/*.out
papers/*/*.pdf
papers/*/*.fls
papers/*/*.fdb_latexmk
papers/*/*.docx
papers/*/main_docx.tex
papers/*/references.bib
dist/
papers/*/tp3.docx
papers/*/titlepage_3a_src.tex

# Manuscript prose is deliberately NOT tracked here. A text-similarity screen
# cannot tell an author's own repository from an external source, and a public
# copy of the full text can trigger a desk rejection at a preprint server.
# The replication artifacts, the generators and the records stay public.
papers/
paper/sections/
paper/main.tex
paper/outline.md
release_assets/REBUILDS.md
